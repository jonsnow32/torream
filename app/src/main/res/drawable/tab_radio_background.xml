<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Checked + focused (TV dpad): primary pill with contrast ring -->
  <item android:state_checked="true" android:state_focused="true">
    <shape android:shape="rectangle">
      <solid android:color="?attr/colorPrimary" />
      <corners android:radius="50dp" />
      <stroke android:width="2dp" android:color="@color/text_primary" />
    </shape>
  </item>

  <!-- Checked: solid primary pill -->
  <item android:state_checked="true">
    <shape android:shape="rectangle">
      <solid android:color="?attr/colorPrimary" />
      <corners android:radius="50dp" />
    </shape>
  </item>

  <!-- Focused unchecked (TV dpad): tonal fill + primary outline -->
  <item android:state_focused="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/settings_highlight_bg" />
      <corners android:radius="50dp" />
      <stroke android:width="1.5dp" android:color="?attr/colorPrimary" />
    </shape>
  </item>

  <!-- Pressed unchecked: tonal feedback -->
  <item android:state_pressed="true">
    <shape android:shape="rectangle">
      <solid android:color="@color/settings_highlight_bg" />
      <corners android:radius="50dp" />
    </shape>
  </item>

  <!-- Default unchecked: transparent -->
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/transparent" />
      <corners android:radius="50dp" />
    </shape>
  </item>
</selector>
