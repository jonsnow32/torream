<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Checked state with background and border -->
  <item android:state_checked="true">
    <layer-list>
      <item>
        <shape android:shape="rectangle">
          <solid android:color="?colorPrimary" />
          <corners android:radius="@dimen/rounded_image_radius" />
          <stroke android:width="1dp" android:color="@color/text_secondary" />
        </shape>
      </item>
    </layer-list>
  </item>

  <!-- Focused state (for TV dpad navigation) -->
  <item android:state_focused="true" android:state_checked="false">
    <shape android:shape="rectangle">
      <solid android:color="@color/background_secondary" />
      <corners android:radius="@dimen/rounded_image_radius" />
      <stroke android:width="1dp" android:color="@color/text_secondary" />
    </shape>
  </item>

  <!-- Default unchecked state -->
  <item>
    <shape android:shape="rectangle">
      <solid android:color="?colorSurface" />
      <corners android:radius="@dimen/rounded_image_radius" />
      <stroke android:width="1dp" android:color="@color/transparent" />
    </shape>
  </item>
</selector>

