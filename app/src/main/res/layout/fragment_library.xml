<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/appBar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="afterDescendants"
    android:focusable="false">

    <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:descendantFocusability="afterDescendants"
      android:focusableInTouchMode="false"
      android:nextFocusLeft="@id/navRailView"
      android:nextFocusDown="@id/tabLayout"
      app:layout_scrollFlags="scroll|enterAlways"
      app:menu="@menu/library_menu"
      app:title="Library" />

    <HorizontalScrollView
      android:id="@+id/tabScrollView"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="?colorSurface"
      android:focusable="false"
      android:clipToPadding="false"
      android:paddingHorizontal="12dp"
      android:paddingTop="2dp"
      android:paddingBottom="10dp"
      android:nextFocusLeft="@id/navRailView"
      android:nextFocusUp="@id/toolbar"
      android:nextFocusDown="@id/rvLibrary"
      android:scrollbars="none"
      app:layout_scrollFlags="noScroll">

      <RadioGroup
        android:id="@+id/tabLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="afterDescendants"
        android:nextFocusLeft="@id/toolbar"
        android:nextFocusRight="@id/rvLibrary"
        android:nextFocusUp="@id/toolbar"
        android:nextFocusDown="@id/rvLibrary">

        <RadioButton
          android:id="@+id/tabDownloads"
          style="@style/LibraryTab"
          android:layout_marginEnd="8dp"
          android:checked="true"
          android:nextFocusLeft="@id/toolbar"
          android:nextFocusRight="@id/tabFavorites"
          android:nextFocusUp="@id/toolbar"
          android:nextFocusDown="@id/rvLibrary"
          android:text="@string/downloads" />

        <RadioButton
          android:id="@+id/tabFavorites"
          style="@style/LibraryTab"
          android:layout_marginEnd="8dp"
          android:nextFocusLeft="@id/tabDownloads"
          android:nextFocusRight="@id/tabHistory"
          android:nextFocusUp="@id/toolbar"
          android:nextFocusDown="@id/rvLibrary"
          android:text="@string/favorites" />

        <RadioButton
          android:id="@+id/tabHistory"
          style="@style/LibraryTab"
          android:layout_marginEnd="8dp"
          android:nextFocusLeft="@id/tabFavorites"
          android:nextFocusRight="@id/tabPlaylists"
          android:nextFocusUp="@id/toolbar"
          android:nextFocusDown="@id/rvLibrary"
          android:text="@string/history" />

        <RadioButton
          android:id="@+id/tabPlaylists"
          style="@style/LibraryTab"
          android:layout_marginEnd="8dp"
          android:nextFocusLeft="@id/tabHistory"
          android:nextFocusRight="@id/tabPrivate"
          android:nextFocusUp="@id/toolbar"
          android:nextFocusDown="@id/rvLibrary"
          android:text="@string/playlists" />

        <RadioButton
          android:id="@+id/tabPrivate"
          style="@style/LibraryTab"
          android:nextFocusLeft="@id/tabPlaylists"
          android:nextFocusUp="@id/toolbar"
          android:nextFocusDown="@id/rvLibrary"
          android:text="@string/private_folder_tab" />
      </RadioGroup>
    </HorizontalScrollView>

    <!-- Storage Stats UI -->
    <cloud.streamless.torream.ui.library.StorageStatsView
      android:id="@+id/storageStatsView"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone"
      tools:visibility="visible" />

  </com.google.android.material.appbar.AppBarLayout>

  <View
    android:id="@+id/appBarOutline"
    style="@style/AppBarOutline"
    android:clickable="false"
    android:focusable="false"
    app:layout_anchor="@id/toolbar"
    app:layout_anchorGravity="bottom" />

  <!-- Main Content -->
  <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:descendantFocusability="afterDescendants"
    android:focusable="false"
    android:nextFocusUp="@id/tabLayout"
    app:layout_behavior="@string/appbar_scrolling_view_behavior">

    <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rvLibrary"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:clipToPadding="false"
      android:nestedScrollingEnabled="true"
      android:nextFocusUp="@id/tabLayout"
      android:paddingHorizontal="8dp"
      android:paddingTop="8dp"
      android:scrollbars="vertical"
      tools:listitem="@layout/item_video" />
  </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
