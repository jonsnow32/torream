<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Title -->
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="32dp"
      android:text="@string/quick_settings"
      android:textColor="?attr/colorOnSurface"
      android:textSize="20sp"
      android:textStyle="bold" />

    <!-- Media group mode -->
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:text="@string/media_group_mode"
      android:textColor="?attr/colorOnSurface"
      android:textSize="14sp" />

    <com.google.android.material.tabs.TabLayout
      android:id="@+id/groupMode"
      style="@style/Widget.MaterialComponents.TabLayout.PrimarySurface"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="32dp"

      app:tabIndicatorFullWidth="true"
      app:tabMode="auto"
      app:tabGravity="fill"
      android:background="@color/transparent">

      <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/view_mode_tree" />

      <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/view_mode_folders" />

      <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/view_mode_carousel" />
    </com.google.android.material.tabs.TabLayout>


    <!-- Media view mode -->
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:text="@string/media_view_mode"
      android:textColor="?attr/colorOnSurface"
      android:textSize="14sp" />

    <com.google.android.material.tabs.TabLayout
      android:id="@+id/viewMode"
      style="@style/Widget.MaterialComponents.TabLayout.PrimarySurface"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="32dp"
      android:background="@color/transparent"
      app:tabGravity="start"
      app:tabIndicatorFullWidth="true"
      app:tabIndicator="@null">

      <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:icon="@drawable/outline_grid_view_24"
        android:text="@string/grid" />

      <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:icon="@drawable/outline_view_agenda_24"
        android:text="@string/list" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Sort Section -->
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:text="@string/sort_by" />

    <com.google.android.material.tabs.TabLayout
      android:id="@+id/sortByTabLayout"
      style="@style/Widget.MaterialComponents.TabLayout.PrimarySurface"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:background="@color/transparent"
      app:tabGravity="start"
      app:tabIndicatorFullWidth="false"
      app:tabMode="scrollable">

      <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:icon="@drawable/ic_baseline_text_format_24"
        android:text="@string/sort_title" />

      <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:icon="@drawable/ic_baseline_access_time_24"
        android:text="@string/sort_duration" />

      <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:icon="@drawable/ic_baseline_calendar_month_24"
        android:text="@string/sort_date" />

      <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:icon="@drawable/ic_baseline_data_usage_24"
        android:text="@string/sort_size" />

      <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:icon="@drawable/ic_folder"
        android:text="@string/sort_location" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Sort Order Buttons -->
    <com.google.android.material.button.MaterialButtonToggleGroup
      android:id="@+id/sortOrderToggleGroup"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:layout_marginBottom="32dp"
      app:singleSelection="true"
      app:selectionRequired="true">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/sortAscButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sort_asc"
        app:icon="@drawable/ic_baseline_arrow_upward_24"
        app:iconGravity="start" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/sortDescButton"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sort_desc"
        app:icon="@drawable/ic_baseline_arrow_downward_24"
        app:iconGravity="start" />
    </com.google.android.material.button.MaterialButtonToggleGroup>
    <!-- Fields to show -->
    <TextView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:text="@string/display_fields"
      android:textColor="?attr/colorOnSurface"
      android:textSize="14sp" />

    <com.google.android.material.chip.ChipGroup
      android:id="@+id/fieldsChipGroup"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginBottom="16dp"
      app:chipSpacingHorizontal="8dp"
      app:chipSpacingVertical="4dp"
      app:singleSelection="false">

      <com.google.android.material.chip.Chip
        android:id="@+id/chipDuration"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="true"
        android:checked="true"
        android:text="@string/field_duration" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chipExtension"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="true"
        android:checked="false"
        android:text="@string/field_extension" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chipPath"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="true"
        android:checked="true"
        android:text="@string/field_path" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chipProgress"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="true"
        android:checked="true"
        android:text="@string/field_progress" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chipResolution"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="true"
        android:checked="false"
        android:text="@string/field_resolution" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chipSize"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="true"
        android:checked="false"
        android:text="@string/field_size" />

      <com.google.android.material.chip.Chip
        android:id="@+id/chipThumbnail"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:checkable="true"
        android:checked="true"
        android:text="@string/field_thumbnail" />
    </com.google.android.material.chip.ChipGroup>

    <!-- Action buttons -->
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="end"
      android:orientation="horizontal">

      <com.google.android.material.button.MaterialButton
        android:id="@+id/cancelButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="@string/cancel" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/applyButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/apply" />
    </LinearLayout>

  </LinearLayout>


</androidx.core.widget.NestedScrollView>
