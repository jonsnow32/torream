<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@null"
  android:orientation="vertical">

  <View
    android:layout_width="32dp"
    android:layout_height="4dp"
    android:layout_gravity="center_horizontal"
    android:layout_marginTop="12dp"
    android:layout_marginBottom="4dp"
    android:alpha="0.4"
    android:background="@drawable/drag_handle_indicator" />

  <TextView
    android:id="@+id/textView2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:text="@string/quick_settings"
    android:textAppearance="?attr/textAppearanceTitleMedium"
    android:textColor="?attr/colorOnSurface"
    android:textStyle="bold" />

  <androidx.core.widget.NestedScrollView
    android:id="@+id/nestedScrollView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingBottom="8dp">

      <!-- Section: Display -->
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/filter_section_display"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/groupMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/folderMode"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/view_mode_folders"
          app:icon="@drawable/ic_folder"
          app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/mediaMode"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/media"
          app:icon="@drawable/ic_baseline_ondemand_video_24"
          app:iconGravity="textStart" />
      </com.google.android.material.button.MaterialButtonToggleGroup>

      <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/viewMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/gridView"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/grid"
          app:icon="@drawable/outline_grid_view_24"
          app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/listView"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/list"
          app:icon="@drawable/outline_view_agenda_24"
          app:iconGravity="textStart" />
      </com.google.android.material.button.MaterialButtonToggleGroup>

      <!-- Section: Sort -->
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/sort_by"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <com.google.android.material.chip.ChipGroup
        android:id="@+id/sortByChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:chipSpacingHorizontal="8dp"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
          android:id="@+id/sortByTitle"
          style="@style/Widget.Material3.Chip.Filter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checkable="true"
          android:text="@string/sort_title" />

        <com.google.android.material.chip.Chip
          android:id="@+id/sortByDuration"
          style="@style/Widget.Material3.Chip.Filter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checkable="true"
          android:text="@string/sort_duration" />

        <com.google.android.material.chip.Chip
          android:id="@+id/sortByDate"
          style="@style/Widget.Material3.Chip.Filter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checkable="true"
          android:text="@string/sort_date" />

        <com.google.android.material.chip.Chip
          android:id="@+id/sortBySize"
          style="@style/Widget.Material3.Chip.Filter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checkable="true"
          android:text="@string/sort_size" />

        <com.google.android.material.chip.Chip
          android:id="@+id/sortByLocation"
          style="@style/Widget.Material3.Chip.Filter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checkable="true"
          android:text="@string/sort_location" />
      </com.google.android.material.chip.ChipGroup>

      <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/sortOrderToggleGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.button.MaterialButton
          android:id="@+id/sortAscButton"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/sort_asc"
          app:icon="@drawable/ic_baseline_arrow_upward_24"
          app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
          android:id="@+id/sortDescButton"
          style="@style/Widget.Material3.Button.OutlinedButton"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:text="@string/sort_desc"
          app:icon="@drawable/ic_baseline_arrow_downward_24"
          app:iconGravity="textStart" />
      </com.google.android.material.button.MaterialButtonToggleGroup>

      <!-- Section: Fields to show -->
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/display_fields"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <com.google.android.material.chip.ChipGroup
        android:id="@+id/fieldsChipGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        app:chipSpacingHorizontal="8dp"
        app:chipSpacingVertical="4dp"
        app:singleSelection="false">

        <com.google.android.material.chip.Chip
          android:id="@+id/chipDuration"
          style="@style/Widget.Material3.Chip.Filter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checkable="true"
          android:checked="true"
          android:text="@string/field_duration" />

        <com.google.android.material.chip.Chip
          android:id="@+id/chipPath"
          style="@style/Widget.Material3.Chip.Filter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checkable="true"
          android:checked="true"
          android:text="@string/field_path" />

        <com.google.android.material.chip.Chip
          android:id="@+id/chipSize"
          style="@style/Widget.Material3.Chip.Filter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checkable="true"
          android:checked="false"
          android:text="@string/field_size" />

        <com.google.android.material.chip.Chip
          android:id="@+id/chipThumbnail"
          style="@style/Widget.Material3.Chip.Filter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checkable="true"
          android:checked="true"
          android:text="@string/field_thumbnail" />

        <com.google.android.material.chip.Chip
          android:id="@+id/chipProgress"
          style="@style/Widget.Material3.Chip.Filter"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:checkable="true"
          android:checked="true"
          android:text="@string/field_progress" />
      </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>

  <!-- Action buttons -->
  <LinearLayout
    android:id="@+id/linearLayout2"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <com.google.android.material.button.MaterialButton
      android:id="@+id/cancelButton"
      style="@style/Widget.Material3.Button.TextButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="8dp"
      android:text="@string/cancel" />

    <com.google.android.material.button.MaterialButton
      android:id="@+id/applyButton"
      style="@style/Widget.Material3.Button.TonalButton"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/apply" />
  </LinearLayout>
</LinearLayout>
