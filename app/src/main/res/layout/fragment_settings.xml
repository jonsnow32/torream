<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <ScrollView
    android:id="@+id/scrollView2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintTop_toTopOf="parent">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="8dp"
      android:paddingEnd="8dp"
      android:paddingBottom="48dp">

      <LinearLayout
        android:id="@+id/settings_profile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        tools:visibility="visible">

        <androidx.cardview.widget.CardView
          android:layout_width="48dp"
          android:layout_height="48dp"
          app:cardCornerRadius="24dp">

          <ImageView
            android:id="@+id/settings_profile_pic"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/account"
            android:foreground="@drawable/rounded_outline"
            android:scaleType="centerCrop"
            android:src="@mipmap/ic_launcher" />
        </androidx.cardview.widget.CardView>

        <TextView
          android:id="@+id/settings_profile_text"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:paddingStart="14dp"
          android:paddingEnd="14dp"
          android:text="@string/app_name"
          android:textColor="@color/text_primary"
          android:textSize="18sp"
          android:textStyle="bold" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/url_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/highlight_item_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusDown="@id/open_local"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_baseline_link_24"
          app:tint="?attr/colorPrimary" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="16dp"
          android:paddingEnd="8dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/input_url"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/input_url_des"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        </LinearLayout>

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_keyboard_arrow_right"
          app:tint="@color/text_secondary" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/open_local"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/preference_focused"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/url_btn"
        android:nextFocusDown="@id/settings_general"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_baseline_ondemand_video_24"
          app:tint="?attr/colorPrimary" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="16dp"
          android:paddingEnd="8dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/open_local_video"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/open_local_video_des"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        </LinearLayout>

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_keyboard_arrow_right"
          app:tint="@color/text_secondary" />
      </LinearLayout>

      <TextView
        android:id="@+id/settings_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:text="@string/title_settings"
        android:textColor="?attr/colorPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

      <LinearLayout
        android:id="@+id/settings_general"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/preference_focused"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/open_local"
        android:nextFocusDown="@id/settings_player"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_outline_settings_24"
          app:tint="?attr/colorPrimary" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="16dp"
          android:paddingEnd="8dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_general"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_general_des"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        </LinearLayout>

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_keyboard_arrow_right"
          app:tint="@color/text_secondary" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/settings_player"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/preference_focused"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/settings_general"
        android:nextFocusDown="@id/settings_cast"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/outline_play_circle_24"
          app:tint="?attr/colorPrimary" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="16dp"
          android:paddingEnd="8dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_player"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_player_des"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        </LinearLayout>

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_keyboard_arrow_right"
          app:tint="@color/text_secondary" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/settings_cast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/preference_focused"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/settings_player"
        android:nextFocusDown="@id/settings_download"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_baseline_cast_24"
          app:tint="?attr/colorPrimary" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="16dp"
          android:paddingEnd="8dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cast_settings"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_cast_des"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        </LinearLayout>

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_keyboard_arrow_right"
          app:tint="@color/text_secondary" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/settings_download"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/preference_focused"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/settings_cast"
        android:nextFocusDown="@id/settings_updates"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_download"
          app:tint="?attr/colorPrimary" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="16dp"
          android:paddingEnd="8dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/download"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_download_des"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        </LinearLayout>

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_keyboard_arrow_right"
          app:tint="@color/text_secondary" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/settings_updates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/preference_focused"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/settings_download"
        android:nextFocusDown="@id/settings_ai_tools"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_baseline_system_update_24"
          app:tint="?attr/colorPrimary" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="16dp"
          android:paddingEnd="8dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/category_updates"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_updates_des"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        </LinearLayout>

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_keyboard_arrow_right"
          app:tint="@color/text_secondary" />
      </LinearLayout>

      <LinearLayout
        android:id="@+id/settings_ai_tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/preference_focused"
        android:gravity="center_vertical"
        android:nextFocusUp="@id/settings_updates"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_baseline_auto_awesome_24"
          app:tint="?attr/colorPrimary" />

        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:paddingStart="16dp"
          android:paddingEnd="8dp">

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ai_tools"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_ai_tools_des"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        </LinearLayout>

        <ImageView
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_keyboard_arrow_right"
          app:tint="@color/text_secondary" />
      </LinearLayout>

    </LinearLayout>
  </ScrollView>

  <LinearLayout
    android:id="@+id/app_version_info"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="horizontal"
    app:layout_constraintBottom_toBottomOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent">

    <TextView
      android:id="@+id/version_info"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:padding="8dp"
      android:textColor="@color/text_secondary"
      android:textSize="12sp"
      tools:text="@string/app_version" />

    <TextView
      android:id="@+id/delimiter0"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="•"
      android:textColor="@color/text_secondary"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/commit_hash"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:padding="8dp"
      android:text="@string/commit_hash"
      android:textColor="@color/text_secondary"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/delimiter1"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="•"
      android:textColor="@color/text_secondary"
      android:textSize="12sp" />

    <TextView
      android:id="@+id/build_date"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:padding="8dp"
      android:textColor="@color/text_secondary"
      android:textSize="12sp"
      tools:text="21/03/2024 09:02 pm" />
  </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
