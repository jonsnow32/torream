<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/mobile_navigation"
  app:startDestination="@id/browseFragment">

  <action
    android:id="@+id/global_to_navigation_player"
    app:destination="@id/playerFragment"
    app:enterAnim="@anim/enter_anim"
    app:exitAnim="@anim/exit_anim"
    app:popEnterAnim="@anim/enter_anim"
    app:popExitAnim="@anim/exit_anim">
    <argument
      android:name="data"
      android:defaultValue="@null"
      app:argType="string" />
    <argument
      android:name="uriData"
      android:defaultValue="@null"
      app:argType="string" />
    <argument
      android:name="resumePosition"
      android:defaultValue="0L"
      app:argType="long" />
  </action>

  <fragment
    android:id="@+id/playerFragment"
    android:name="cloud.app.csplayer.ui.player.CSPlayerFragment"
    android:label="PlayerFragment" />

  <fragment
    android:id="@+id/browseFragment"
    android:name="cloud.app.csplayer.ui.browse.BrowseFragment"
    android:label="BrowseFragment" />
</navigation>
