<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Night mode theme (Dark Theme) -->
  <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
    <!-- Primary colors - OneUI Blue -->
    <item name="colorPrimary">#4D9FFF</item>
    <item name="colorPrimaryVariant">#0078D4</item>
    <item name="colorOnPrimary">#000000</item>

    <!-- Secondary colors - OneUI Accent -->
    <item name="colorSecondary">#4D9FFF</item>
    <item name="colorSecondaryVariant">#0078D4</item>
    <item name="colorOnSecondary">#000000</item>

    <!-- Background colors - OneUI Dark -->
    <item name="android:colorBackground">#000000</item>
    <item name="colorSurface">#1C1C1E</item>
    <item name="colorOnBackground">#B0B0B0</item>
    <item name="colorOnSurface">#B0B0B0</item>

    <!-- Status bar -->
    <item name="android:statusBarColor">?colorSurface</item>
    <item name="android:navigationBarColor">#000000</item>
    <item name="android:windowLightStatusBar">false</item>


    <!-- Dialog theme -->
    <item name="alertDialogTheme">@style/Theme.AlertDialog.Dark</item>

    <!-- Tab style -->
    <item name="tabStyle">@style/Theme.Widget.Tabs.Dark</item>

    <!-- Item Cover Sizes -->
    <item name="itemCoverSize">55dp</item>
    <item name="itemCoverSize2x">110dp</item>
    <item name="itemCoverSize3x">165dp</item>

    <!-- MainColors attributes - OneUI Dark Style -->
    <item name="colorSearch">#4D9FFF</item>
    <item name="colorOngoing">#4D9FFF</item>
    <item name="primaryGrayBackground">#1C1C1E</item>
    <item name="primaryBlackBackground">#000000</item>
    <item name="iconGrayBackground">#2C2C2E</item>
    <item name="boxItemBackground">#1C1C1E</item>

    <item name="android:divider">@color/transparent</item>
    <item name="divider">@color/transparent</item>
    <item name="android:dividerHeight">0dp</item>
    <item name="showDividers">none</item>
    <item name="android:listViewStyle">@style/ListViewStyle</item>
    <item name="android:textViewStyle">@style/AppTextViewStyle</item>

    <!-- preferences -->
    <item name="preferenceTheme">@style/CustomPreferenceThemeOverlay</item>
  </style>
</resources>
