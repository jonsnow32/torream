<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Checked: text on primary pill -->
  <item android:state_checked="true" android:color="?attr/colorOnPrimary" />
  <!-- Focused unchecked (TV dpad) -->
  <item android:state_focused="true" android:color="@color/text_primary" />
  <!-- Default unchecked -->
  <item android:color="@color/text_secondary" />
</selector>
