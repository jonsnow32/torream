<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Base application theme - Light Theme (Default) -->
  <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
    <!-- Primary colors - OneUI Blue -->
    <item name="colorPrimary">#0078D4</item>
    <item name="colorPrimaryVariant">#005A9E</item>
    <item name="colorOnPrimary">#FFFFFF</item>

    <!-- Secondary colors - OneUI Accent -->
    <item name="colorSecondary">#0078D4</item>
    <item name="colorSecondaryVariant">#005A9E</item>
    <item name="colorOnSecondary">#FFFFFF</item>

    <!-- Background colors - OneUI Light -->
    <item name="android:colorBackground">#EEEEEE</item>
    <item name="colorSurface">#F5F5F5</item>
    <item name="colorOnBackground">#1C1C1E</item>
    <item name="colorOnSurface">#1C1C1E</item>

    <!-- Status bar -->
<!--    <item name="android:statusBarColor">#80FFFFFF</item>-->
<!--    <item name="android:navigationBarColor">#EEEEEE</item>-->
<!--    <item name="android:windowLightStatusBar">true</item>-->
<!--    <item name="android:windowDrawsSystemBarBackgrounds">true</item>-->

    <!-- Dialog theme -->
    <item name="alertDialogTheme">@style/Theme.AlertDialog.Light</item>

    <!-- Tab style -->
    <item name="tabStyle">@style/Theme.Widget.Tabs.Light</item>

    <!-- Item Cover Sizes -->
    <item name="itemCoverSize">55dp</item>
    <item name="itemCoverSize2x">110dp</item>
    <item name="itemCoverSize3x">165dp</item>

    <!-- MainColors attributes - OneUI Style -->
    <item name="colorSearch">#0078D4</item>
    <item name="colorOngoing">#0078D4</item>
    <item name="primaryGrayBackground">#EEEEEE</item>
    <item name="primaryBlackBackground">#F5F5F5</item>
    <item name="iconGrayBackground">#DCDCDC</item>
    <item name="boxItemBackground">#EEEEEE</item>

    <item name="android:divider">@color/transparent</item>
    <item name="divider">@color/transparent</item>
    <item name="android:dividerHeight">0dp</item>
    <item name="showDividers">none</item>
    <item name="android:listViewStyle">@style/ListViewStyle</item>
    <item name="android:textViewStyle">@style/AppTextViewStyle</item>

    <!-- preferences -->
    <item name="preferenceTheme">@style/CustomPreferenceThemeOverlay</item>

    <!-- button -->
    <item name="materialButtonStyle">@style/AppButtonStyle</item>
    <item name="materialButtonOutlinedStyle">@style/AppOutlinedButtonStyle</item>

    <item name="collapsingToolbarLayoutStyle">@style/CollapsingBar</item>
  </style>

  <!-- Alert Dialog Theme - Dark -->
  <style name="Theme.AlertDialog.Dark" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
    <item name="colorPrimary">#BB86FC</item>
    <item name="colorOnSurface">#FFFFFF</item>
    <item name="android:colorBackground">#1E1E1E</item>
  </style>

  <!-- Alert Dialog Theme - Light -->
  <style name="Theme.AlertDialog.Light" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
    <item name="colorPrimary">#0078D4</item>
    <item name="colorOnSurface">#666666</item>
    <item name="android:colorBackground">#F5F5F5</item>
  </style>

  <!-- Tab Layout Style - Dark -->
  <style name="Theme.Widget.Tabs.Dark" parent="Widget.MaterialComponents.TabLayout.Colored">
    <item name="tabIndicatorColor">#BB86FC</item>
    <item name="tabTextColor">#BBBBBB</item>
    <item name="tabSelectedTextColor">#FFFFFF</item>
  </style>

  <!-- Tab Layout Style - Light -->
  <style name="Theme.Widget.Tabs.Light" parent="Widget.MaterialComponents.TabLayout.Colored">
    <item name="tabIndicatorColor">#0078D4</item>
    <item name="tabTextColor">#999999</item>
    <item name="tabSelectedTextColor">#666666</item>
  </style>

  <!-- Chip Style -->
  <style name="ChipFilled" parent="Widget.Material3.Chip.Filter">
    <item name="chipBackgroundColor">#BB86FC</item>
    <item name="android:textColor">#000000</item>
  </style>

  <!-- ListView Style -->
  <style name="ListViewStyle" parent="Widget.AppCompat.ListView">
    <item name="android:divider">@color/divider_color</item>
    <item name="android:dividerHeight">1dp</item>
    <item name="android:listSelector">@drawable/outline_drawable_forced</item>
    <item name="android:drawSelectorOnTop">false</item>
  </style>

  <!-- Media Item Style - Used in various list items -->
  <style name="MediaItem">
    <item name="android:background">?attr/selectableItemBackground</item>
    <item name="android:clickable">true</item>
    <item name="android:focusable">true</item>
  </style>


  <!-- App Bar Outline Style -->
  <style name="AppBarOutline">
    <item name="android:background">?attr/primaryGrayBackground</item>
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">2dp</item>
  </style>

  <!-- Search Box Style - Base for subtitle/audio buttons -->
  <style name="SearchBox">
    <item name="android:textColor">?attr/colorOnSurface</item>
    <item name="android:background">?attr/primaryGrayBackground</item>
  </style>

  <!-- Loaded Style - Empty placeholder for compatibility -->
  <style name="LoadedStyle" />


  <!-- Color Picker View Style -->
  <style name="cpv_ColorPickerViewStyle">
    <item name="android:background">?attr/primaryGrayBackground</item>
  </style>

  <!-- Video Button Styles -->
  <style name="VideoButton">
    <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    <item name="android:tint">?attr/colorOnSurface</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">25dp</item>
  </style>

  <style name="VideoButtonTV">
    <item name="android:background">?attr/selectableItemBackground</item>
    <item name="android:tint">?attr/colorOnSurface</item>
    <item name="android:focusable">true</item>
    <item name="android:layout_width">wrap_content</item>
    <item name="android:layout_height">25dp</item>
  </style>


  <!-- Watch Header Text Style -->
  <style name="WatchHeaderText">
    <item name="android:textSize">16sp</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/text_primary</item>
  </style>


  <style name="NoCheckLabel" parent="@style/AppTextViewStyle">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">?android:attr/listPreferredItemHeightSmall</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:paddingHorizontal">12dp</item>
    <item name="android:ellipsize">marquee</item>
    <item name="android:maxLines">2</item>
    <item name="android:foreground">?attr/selectableItemBackgroundBorderless</item>
    <item name="android:drawablePadding">20dp</item>
  </style>

  <style name="CheckLabel" parent="@style/NoCheckLabel">
    <item name="drawableStartCompat">@drawable/ic_check_24_listview</item>
    <item name="android:checkMarkTintMode">src_in</item>
  </style>

  <!-- Text View Style -->
  <style name="AppTextViewStyle" parent="android:Widget.TextView">
    <item name="android:textColor">@color/text_primary</item>
    <item name="android:fontFamily">@font/google_sans</item>
  </style>

  <!-- Specific dialog themes -->

  <style name="BaseMaterialDialogTheme" parent="ThemeOverlay.Material3.Dialog">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowIsFloating">true</item>
    <item name="android:windowBackground">@drawable/rounded_dialog</item>
    <item name="android:windowMinWidthMajor">@dimen/abc_dialog_min_width_major</item>
    <item name="android:windowMinWidthMinor">@dimen/abc_dialog_min_width_minor</item>
    <item name="android:textAllCaps">false</item>
    <item name="colorControlActivated">?attr/colorPrimary</item>
  </style>


  <style name="BaseMaterialDialogAnimation" parent="MaterialAlertDialog.Material3">
    <item name="android:windowFullscreen">true</item>
  </style>

  <style name="CenterMaterialDialogAnimation" parent="BaseMaterialDialogAnimation">
    <item name="android:windowEnterAnimation">@android:anim/fade_in</item>
    <item name="android:windowExitAnimation">@android:anim/fade_out</item>
  </style>

  <style name="RightMaterialDialogAnimation" parent="BaseMaterialDialogAnimation">
    <item name="android:windowEnterAnimation">@anim/slide_in_right</item>
    <item name="android:windowExitAnimation">@anim/slide_out_right</item>
  </style>

  <style name="LeftMaterialDialogAnimation" parent="BaseMaterialDialogAnimation">
    <item name="android:windowEnterAnimation">@anim/slide_in_left</item>
    <item name="android:windowExitAnimation">@anim/slide_out_left</item>
  </style>

  <style name="BottomMaterialDialogAnimation" parent="BaseMaterialDialogAnimation">
    <item name="android:windowEnterAnimation">@anim/slide_in_bottom</item>
    <item name="android:windowExitAnimation">@anim/slide_out_bottom</item>
  </style>

  <style name="RightMaterialDialogTheme" parent="BaseMaterialDialogTheme">
    <item name="android:windowAnimationStyle">@style/RightMaterialDialogAnimation</item>
  </style>

  <style name="LeftMaterialDialogTheme" parent="BaseMaterialDialogTheme">
    <item name="android:windowAnimationStyle">@style/LeftMaterialDialogAnimation</item>
  </style>

  <style name="BottomMaterialDialogTheme" parent="BaseMaterialDialogTheme">
    <item name="android:windowAnimationStyle">@style/BottomMaterialDialogAnimation</item>
  </style>

  <style name="CenterMaterialDialogTheme" parent="BaseMaterialDialogTheme">
    <item name="android:windowAnimationStyle">@style/CenterMaterialDialogAnimation</item>
  </style>

  <style name="CustomPreferenceStyle" parent="@style/Preference.Material">
    <item name="android:layout">@layout/custom_preference_material</item>
  </style>

  <style name="CustomSwitchPreferenceStyle" parent="@style/Preference.SwitchPreference.Material">
    <item name="android:layout">@layout/custom_preference_material</item>
  </style>

  <style name="CustomSeekBarPreferenceStyle" parent="@style/Preference.SeekBarPreference.Material">
    <item name="android:layout">@layout/custom_preference_widget_seekbar</item>
  </style>

  <style name="CustomPreferenceThemeOverlay" parent="@style/PreferenceThemeOverlay">
    <item name="android:layout">@layout/settings_title_top</item>
    <item name="preferenceStyle">@style/CustomPreferenceStyle</item>
    <item name="switchPreferenceStyle">@style/CustomSwitchPreferenceStyle</item>
    <item name="seekBarPreferenceStyle">@style/CustomSeekBarPreferenceStyle</item>
  </style>

  <!-- Navigation View Style -->
  <style name="BottomNavbarActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
    <item name="android:width">56dp</item>
    <item name="android:height">24dp</item>
    <item name="android:color">?attr/colorPrimaryInverse</item>
  </style>

  <style name="NavView" parent="Widget.Material3.BottomNavigationView">
    <item name="android:background">?colorSurface</item>
    <item name="itemActiveIndicatorStyle">@style/BottomNavbarActiveIndicator</item>
    <item name="labelVisibilityMode">labeled</item>
    <item name="itemPaddingBottom">12dp</item>
    <item name="itemPaddingTop">12dp</item>
    <item name="itemMinHeight">64dp</item>
    <item name="android:paddingTop">0dp</item>
    <item name="android:paddingBottom">0dp</item>
    <item name="itemIconTint">@color/item_select_color</item>
    <item name="itemTextColor">@color/item_select_color</item>
  </style>

  <style name="NavRailView" parent="Widget.Material3.BottomNavigationView">
    <item name="android:background">?colorSurface</item>
    <item name="itemActiveIndicatorStyle">@style/BottomNavbarActiveIndicator</item>
    <item name="labelVisibilityMode">labeled</item>
    <item name="itemPaddingBottom">12dp</item>
    <item name="itemPaddingTop">12dp</item>
    <item name="itemMinHeight">64dp</item>
    <item name="android:paddingTop">0dp</item>
    <item name="android:paddingBottom">0dp</item>
    <item name="itemIconTint">@color/item_select_color</item>
    <item name="itemTextColor">@color/item_select_color</item>
    <item name="android:focusable">true</item>
    <item name="android:focusableInTouchMode">true</item>
    <item name="elevation">0dp</item>
    <item name="menuGravity">center</item>
    <item name="android:minWidth">@dimen/nav_height</item>
  </style>

  <!-- Global Button Style - OneUI Style -->
  <style name="AppButtonStyle" parent="Widget.Material3.Button">
    <item name="android:background">@drawable/button_background</item>
    <item name="android:foreground">?attr/selectableItemBackground</item>
    <item name="android:textColor">?attr/colorOnPrimary</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">15sp</item>
    <item name="android:letterSpacing">0.01</item>
    <item name="android:paddingStart">32dp</item>
    <item name="android:paddingEnd">32dp</item>
    <item name="android:paddingTop">14dp</item>
    <item name="android:paddingBottom">14dp</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:minWidth">88dp</item>
    <item name="android:focusable">true</item>
    <item name="android:focusableInTouchMode">false</item>
    <item name="backgroundTint">@null</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="elevation">0dp</item>
    <item name="android:textAllCaps">false</item>
  </style>

  <!-- Outlined Button Style - OneUI Style -->
  <style name="AppOutlinedButtonStyle" parent="Widget.Material3.Button.OutlinedButton">
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">15sp</item>
    <item name="android:letterSpacing">0.01</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:minWidth">88dp</item>
    <item name="android:paddingStart">32dp</item>
    <item name="android:paddingEnd">32dp</item>
    <item name="cornerRadius">8dp</item>
    <item name="strokeWidth">2dp</item>
    <item name="strokeColor">?attr/colorPrimary</item>
    <item name="rippleColor">?attr/colorPrimary</item>
    <item name="android:textAllCaps">false</item>
  </style>

  <!-- Text Button Style - OneUI Style -->
  <style name="AppTextButtonStyle" parent="Widget.Material3.Button.TextButton">
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">15sp</item>
    <item name="android:letterSpacing">0.01</item>
    <item name="android:minHeight">52dp</item>
    <item name="android:paddingStart">16dp</item>
    <item name="android:paddingEnd">16dp</item>
    <item name="android:textAllCaps">false</item>
    <item name="rippleColor">?attr/colorPrimary</item>
  </style>

  <style name="TabNoCaps" parent="TextAppearance.Design.Tab">
    <item name="textAllCaps">false</item>
    <item name="fontFamily">@font/google_sans</item>
  </style>

  <style name="TopCollapsingBar" parent="Widget.Material3.CollapsingToolbar.Large">
    <item name="contentScrim">?colorSurface</item>
    <item name="expandedTitleMarginBottom">20dp</item>
    <item name="expandedTitleMarginEnd">24dp</item>
    <item name="expandedTitleMarginStart">24dp</item>
    <item name="titleCollapseMode">scale</item>
    <item name="layout_scrollFlags">scroll|exitUntilCollapsed|snap</item>
  </style>

  <style name="CollapsingBar" parent="TopCollapsingBar"/>
</resources>

