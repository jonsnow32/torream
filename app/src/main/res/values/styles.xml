<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Base application theme - Light Theme (Default) -->
  <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">

    <!-- Primary colors - OneUI Blue -->
    <item name="colorPrimary">@color/md_theme_primary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="colorOnPrimary">@color/md_theme_onPrimary</item>

    <!-- Secondary colors - OneUI Accent -->
    <item name="colorSecondary">@color/md_theme_secondary</item>
    <item name="colorOnSecondary">@color/md_theme_onSecondaryContainer</item>

    <!-- Background colors - OneUI Light -->
    <item name="android:colorBackground">@color/md_theme_background</item>
    <item name="colorOnBackground">@color/md_theme_onBackground</item>
    <item name="colorSurface">@color/md_theme_surface</item>
    <item name="colorOnSurface">@color/md_theme_onSurface</item>
    <item name="colorSurfaceContainer">@color/oneui_gray_background</item>
    <!-- Status bar -->
<!--    <item name="android:statusBarColor">@color/oneui_status_bar</item>-->
<!--    <item name="android:navigationBarColor">@color/oneui_navigation_bar</item>-->
<!--    <item name="android:windowLightStatusBar">true</item>-->
<!--    <item name="android:windowDrawsSystemBarBackgrounds">true</item>-->

    <!-- Dialog theme -->
    <item name="alertDialogTheme">@style/Theme.AlertDialog.Light</item>

    <!-- Tab style -->
    <item name="tabStyle">@style/Theme.Widget.Tabs.Light</item>

    <!-- Item Cover Sizes -->
    <item name="itemCoverSize">55dp</item>
    <item name="itemCoverSize2x">110dp</item>
    <item name="itemCoverSize3x">165dp</item>

    <!-- MainColors attributes - OneUI Style -->
    <item name="colorSearch">@color/oneui_search</item>
    <item name="colorOngoing">@color/oneui_ongoing</item>
    <item name="primaryGrayBackground">@color/oneui_gray_background</item>
    <item name="primaryBlackBackground">@color/oneui_black_background</item>
    <item name="iconGrayBackground">@color/oneui_icon_gray_background</item>
    <item name="boxItemBackground">@color/oneui_box_item_background</item>

    <item name="android:divider">@color/transparent</item>
    <item name="divider">@color/transparent</item>
    <item name="android:dividerHeight">0dp</item>
    <item name="showDividers">none</item>
    <item name="android:listViewStyle">@style/ListViewStyle</item>
    <item name="android:textViewStyle">@style/AppTextViewStyle</item>

    <!-- preferences -->
    <item name="preferenceTheme">@style/CustomPreferenceThemeOverlay</item>

    <!-- button -->
    <item name="materialButtonStyle">@style/AppButtonStyle</item>
    <item name="materialButtonOutlinedStyle">@style/AppOutlinedButtonStyle</item>

    <item name="collapsingToolbarLayoutStyle">@style/CollapsingBar</item>

    <!-- Cast device picker dialog style -->
    <item name="mediaRouteTheme">@style/MediaRouteDialogTheme</item>
  </style>

  <!-- Color themes - Light variants -->

  <style name="Theme.AmoledBlack" parent="AppTheme" />

