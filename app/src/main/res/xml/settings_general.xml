<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto">

  <PreferenceCategory android:title="@string/category_ui">

    <Preference
      android:layout="@layout/custom_preference"
      android:icon="@drawable/ic_baseline_color_lens_24"
      android:key="@string/app_theme_key"
      android:summary="@string/app_theme_settings_des"
      android:title="@string/app_theme_settings" />

    <Preference
      android:layout="@layout/custom_preference"
      android:icon="@drawable/ic_baseline_tv_24"
      android:key="@string/app_layout_key"
      android:summary="@string/app_layout_des"
      android:title="@string/app_layout" />

    <Preference
      android:icon="@drawable/ic_baseline_language_24"
      android:key="@string/locale_key"
      android:layout="@layout/custom_preference"
      android:summary="@string/app_language_des"
      android:title="@string/app_language" />


  </PreferenceCategory>

  <PreferenceCategory android:title="@string/category_notifications">

    <SwitchPreferenceCompat
      android:icon="@drawable/ic_baseline_notifications_active_24"
      android:layout="@layout/custom_switch_preference"
      android:summary="@string/continue_watching_reminder_summary"
      android:title="@string/continue_watching_reminder"
      app:defaultValue="true"
      app:key="@string/continue_watching_reminder_key" />

  </PreferenceCategory>

  <PreferenceCategory android:title="@string/title_downloads" app:isPreferenceVisible="false">

    <Preference
      android:icon="@drawable/ic_download"
      android:key="@string/download_path_key"
      android:layout="@layout/custom_preference"
      android:title="@string/download_path_pref" />

    <Preference
      android:icon="@drawable/ic_battery"
      android:key="@string/battery_optimisation_key"
      android:layout="@layout/custom_preference"
      android:title="@string/battery_dialog_title" />

  </PreferenceCategory>

  <PreferenceCategory android:title="@string/pref_category_bypass">
    <Preference
      app:isPreferenceVisible="false"
      android:icon="@drawable/ic_baseline_add_24"
      android:key="@string/override_site_key"
      android:layout="@layout/custom_preference"
      android:summary="@string/add_site_summary"
      android:title="@string/add_site_pref" />

    <Preference
      android:icon="@drawable/ic_baseline_dns_24"
      android:key="@string/dns_key"
      android:layout="@layout/custom_preference"
      android:summary="@string/dns_pref_summary"
      android:title="@string/dns_pref" />

    <Preference
      android:icon="@drawable/outline_ad_24"
      android:key="@string/ad_key"
      android:layout="@layout/custom_preference"
      android:summary="@string/ad_testing_des"
      android:title="@string/ad_testing" />

  </PreferenceCategory>

</PreferenceScreen>
