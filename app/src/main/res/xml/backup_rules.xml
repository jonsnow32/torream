<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older that API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Media index is derived from MediaStore content:// URIs that require runtime
         permissions which are never restored alongside backed-up app data. Restoring
         a stale DB skips the empty-DB permission/sync check and causes playback
         failures for entries the app no longer has access to. -->
    <exclude domain="database" path="media_database"/>
    <exclude domain="database" path="media_database-wal"/>
    <exclude domain="database" path="media_database-shm"/>
</full-backup-content>