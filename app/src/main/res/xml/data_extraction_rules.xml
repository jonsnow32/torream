<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Media index rows reference content:// URIs gated by runtime permissions that
         are never restored with app data - a restored DB would skip the empty-DB
         permission/sync check and cause playback failures for stale entries. -->
    <cloud-backup>
        <exclude domain="database" path="media_database"/>
        <exclude domain="database" path="media_database-wal"/>
        <exclude domain="database" path="media_database-shm"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="media_database"/>
        <exclude domain="database" path="media_database-wal"/>
        <exclude domain="database" path="media_database-shm"/>
    </device-transfer>
</data-extraction-rules>